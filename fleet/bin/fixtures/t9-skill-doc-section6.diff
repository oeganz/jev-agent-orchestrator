+
+```js
+// 5c recipe 2 - GATE ROUTING (edit criteria/constraints + state, then: node gate-task.mjs)
+import { loadEnv } from 'file:///<repo>/Agent/Orchestrator/fleet/bin/lib/env.mjs';
+import { loadFleetConfig, buildGateQuestions, askFromConfig } from 'file:///<repo>/Agent/Orchestrator/fleet/bin/lib/jev-router.mjs';
+import { gateVerdict } from 'file:///<repo>/Agent/Orchestrator/fleet/bin/lib/jev.mjs';
+loadEnv();
+const cfg = loadFleetConfig();
+const criteria = ['node --test fleet/bin/jev-router.test.mjs exits 0', 'the report pastes raw test output'];  // the spec's criteria, verbatim
+const constraints = ['no new dependencies'];  // the spec's constraints, verbatim strings
+const g = buildGateQuestions({ criteria, constraints });  // not_met_<i>/violated_<i> nouls + route choice
+const state = { task: 'T9: two 5c snippets extracted and executed', report: 'suite green',
+                evidence: '# tests 67\n# pass 67\n# fail 0' };  // paste the REAL output - never a summary
+const fetchImpl = globalThis.fetch;
+const ask = askFromConfig(cfg, { fetchImpl });
+const detail = await ask(state, g.questions);
+const v = gateVerdict(detail, { decisive: ['accept', 'rework'] });  // replan/ask_user escalate to you
+console.log(JSON.stringify({ v, fingerprint: g.fingerprint, model: detail.model, provider: detail.provider }));
