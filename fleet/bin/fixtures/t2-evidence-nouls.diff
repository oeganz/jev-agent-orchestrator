diff --git a/fleet/bin/lib/jev-router.mjs b/fleet/bin/lib/jev-router.mjs
index 7f7c194..4253398 100644
--- a/fleet/bin/lib/jev-router.mjs
+++ b/fleet/bin/lib/jev-router.mjs
@@ -205 +205,34 @@ const DEFAULT_GATE_ROUTES = {
-export function buildGateQuestions({ criteria = [], constraints = [], routes = DEFAULT_GATE_ROUTES } = {}) {
+//
+// evidence_gap is SCOPED TO ACCEPTANCE CRITERIA (T2-evidence-nouls). The prior
+// generic wording ("Does the report claim results that the raw evidence pasted
+// in state does not show?") fired on clean work - measured 2026-10-07:
+// 0.63/0.73/0.69 (T7), 0.75 (T9), 0.47 (T1) - while every per-criterion noul
+// was <= 0.20 and the orchestrator reproduced every criterion. It reacted to the
+// NUMBER of side claims a long report carries (TDD narrative, design notes) that
+// no evidence could ever show; a 6KB report scored 0.26. The key stays
+// `evidence_gap` so gates.jsonl rows remain comparable; the wording change moves
+// the fingerprint, which is the point (a threshold is calibrated per wording).
+//
+// deleted_out_of_scope is added ONLY when the caller passes a `diff` that shows
+// lines DELETED outside the owned files/sections. T9 shipped a 41-line deletion
+// outside scope and the constraint noul ("only 5c changed") scored 0.12 - the
+// deletion was invisible to the nouls. The orchestrator must paste
+// `git diff -U0 <base>..<head> | grep "^-[^-]"` into the gate state's evidence
+// for this noul to have anything to read; `deletedLines()` below builds that
+// input from raw `git diff -U0` output.
+export function deletedLines(diffText) {
+  const out = [];
